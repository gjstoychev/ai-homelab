{
  "requiredMinimumVersion": "2.1.285",
  "env": {
    "DISABLE_UPDATES": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/**/.env)",
      "Read(~/.claude/.credentials.json)",
      "Bash(sudo *)",
      "Bash(git push *)"
    ]
  },
  "allowManagedHooksOnly": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "bwrapPath": "/usr/local/bin/claude-bwrap",
    "network": {
      "allowManagedDomainsOnly": true,
      "strictAllowlist": true,
      "allowedDomains": [
        "pypi.org",
        "registry.npmjs.org",
        "downloads.claude.ai",
        "api.github.com"
      ]
    },
    "filesystem": {
      "allowManagedReadPathsOnly": true,
      "denyRead": [
        "~/**/.env"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "CLAUDE_CODE_MESSAGING_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}
