# Managed by Ansible (role lab0b_demo). Lab 0b: a self-written service with a
# secret, as a contrast to Ollama. Serves /var/lib/lab0b-demo on loopback.
[Unit]
Description=Lab 0b demo service (python3 -m http.server)

[Service]
ExecStart=/usr/bin/python3 -m http.server 8765 --bind 127.0.0.1 --directory /var/lib/lab0b-demo
# A user and group allocated at start and released at stop; no account in /etc/passwd.
DynamicUser=yes
# /var/lib/lab0b-demo, created by systemd and owned by the dynamic user.
StateDirectory=lab0b-demo
# Read by systemd (root) before the process starts; root:root 0600, created by hand.
EnvironmentFile=/etc/lab0b-demo.env
Restart=on-failure

# Resource limits (Lab 0b, step 17).
MemoryMax=64M
CPUQuota=50%
TasksMax=16

# Hardening (Lab 0b, step 17). DynamicUser= already implies ProtectSystem=strict,
# ProtectHome=read-only, PrivateTmp, NoNewPrivileges, RestrictSUIDSGID, RemoveIPC.
# The same set as Ollama, plus what Ollama cannot have: no devices, only process
# entries in /proc, no traffic except loopback, no @resources, UMask=0077.
ProtectHome=yes
PrivateDevices=yes
PrivateUsers=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
